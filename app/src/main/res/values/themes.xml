<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Danmuji" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="OverlayIconButton">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="OverlayActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">#FF9FD3FF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="OverlayVideoButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">30dp</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:textColor">#FF9FD3FF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
</resources>
